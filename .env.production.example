# Production Environment Variables
# Copy this to .env.production and fill in your values

# S3 Bucket URL for worksheets
NEXT_PUBLIC_S3_BUCKET_URL=https://kids-learning-worksheets-104071297930.s3.us-east-1.amazonaws.com

# S3 Configuration (for scripts and API)
S3_BUCKET_NAME=kids-learning-worksheets-104071297930
AWS_REGION=us-east-1

# AWS Credentials (use IAM roles in production instead)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
